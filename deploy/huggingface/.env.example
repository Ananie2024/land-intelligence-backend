# =============================================================================
# Land Intelligence — Hugging Face Space environment variables
# =============================================================================
# Set these in the HF Space dashboard:
#   Settings -> Variables and secrets -> New variable
# (Do NOT hard-code secrets in the repo; use the Space's secret store.)
# =============================================================================

# Application environment — enables production hardening (CORS checks, docs off).
ENVIRONMENT=production

# HF Spaces assigns this automatically (default 7860). Keep it aligned with
# Spacefile `app_port`.
PORT=7860
API_PORT=7860

# -----------------------------------------------------------------------------
# DATABASE — Supabase (see deploy/supabase/.env.supabase.example for guidance)
# -----------------------------------------------------------------------------
DATABASE_HOST=db.<your-project-ref>.supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
DATABASE_PASSWORD=<your-supabase-database-password>
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# SECURITY — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=<your-random-secret-key-at-least-32-chars>
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=60
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# CORS — the browser origin(s) of the Vercel frontend. JSON array.
# Example: Vercel preview URLs and your custom domain.
CORS_ORIGINS=["https://<your-app>.vercel.app","https://<your-custom-domain>"]

# -----------------------------------------------------------------------------
# REDIS (optional, in-container for JWT token blacklist)
# -----------------------------------------------------------------------------
# START_REDIS=true runs an in-memory redis-server inside the Space.
# Without it the token blacklist fails OPEN (revoked tokens remain valid until
# expiry — see app/core/token_blacklist.py). Set SECURITY_CRITICAL_MODE=true
# only if you fully control Redis availability.
START_REDIS=true
REDIS_URL=redis://localhost:6379/0
SECURITY_CRITICAL_MODE=false

# -----------------------------------------------------------------------------
# STORAGE — HF free tier disk is EPHEMERAL (uploads/backups do not persist).
# Prefer GCS / Backblaze B2 for durable object storage if needed.
# -----------------------------------------------------------------------------
FILE_STORAGE_PATH=/app/file-storage
BACKUP_BASE_PATH=/app/backups
LOG_FILE_PATH=/app/logs/app.log
LOG_LEVEL=INFO

# -----------------------------------------------------------------------------
# RUNTIME
# -----------------------------------------------------------------------------
# Keep 1 worker on free tier (limited CPU/RAM). Raise only on paid tiers.
UVICORN_WORKERS=1
RUN_MIGRATIONS=true
