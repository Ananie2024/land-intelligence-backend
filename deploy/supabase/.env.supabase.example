# =============================================================================
# Land Intelligence — Supabase environment variables
# =============================================================================
# Copy to a private file (e.g. `.env.supabase`) and fill in the REAL values from
# your Supabase project dashboard:
#   Project Settings -> Database -> Connection string -> "Session pooler".
#
# The app reads these through app/core/config.py, which builds DATABASE_URL as:
#   postgresql://{USER}:{PASSWORD}@{HOST}:{PORT}/{NAME}
# Alembic (alembic/env.py) converts this to postgresql+psycopg2:// for sync runs.
# =============================================================================

# -----------------------------------------------------------------------------
# DATABASE — Supabase (project ref: jbaohbvvjsfmhmvlsufb)
# -----------------------------------------------------------------------------
# Recommended: use the SESSION pooler host (IPv4, stable).
# It looks like:  <region>.pooler.supabase.com  (e.g. aws-0-<region>.pooler.supabase.com)
# The direct host (db.<ref>.supabase.co) is IPv6-only and often not routable from
# on-prem/VPN networks — use the pooler for the app and for alembic.
DATABASE_HOST=aws-0-<REGION>.pooler.supabase.com
# Session pooler uses 5432. The transaction pooler uses 6543 (use 5432 = session).
DATABASE_PORT=5432
DATABASE_NAME=postgres
# NOTE: With the pooler the USER is "<db-user>.<project-ref>", e.g.:
#   postgres.jbaohbvvjsfmhmvlsufb
DATABASE_USER=postgres.jbaohbvvjsfmhmvlsufb
DATABASE_PASSWORD=<your-supabase-database-password>

# Log every SQL statement (set true only while debugging).
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# Security (required by Settings) — generate with:
#   python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=<random-secret-at-least-32-chars>

# -----------------------------------------------------------------------------
# Example full connection URLs (replace <REGION>, <PASSWORD>):
#   Session pooler (recommended for the app + alembic):
#     postgresql://postgres.jbaohbvvjsfmhmvlsufb:<PASSWORD>@aws-0-<REGION>.pooler.supabase.com:5432/postgres
#   Direct (IPv6 only):
#     postgresql://postgres:<PASSWORD>@db.jbaohbvvjsfmhmvlsufb.supabase.co:5432/postgres
# =============================================================================
