# =============================================================================
# Land Intelligence — Backend environment for a SUPABASE database
# =============================================================================
# This is a TEMPLATE for connecting the FastAPI backend to a Supabase Postgres
# database. Copy the relevant values into the Hugging Face Space environment
# variables (see deploy/huggingface/.env.example) or into a local `.env`
# whenever you run Alembic migrations against Supabase.
#
# NEVER commit the real .env — keep this file as a template only.
# =============================================================================

ENVIRONMENT=production

# -----------------------------------------------------------------------------
# DATABASE — individual fields (config.py assembles these into DATABASE_URL)
# -----------------------------------------------------------------------------
# In the Supabase dashboard: Project Settings -> Database -> Connection string.
# Use the DIRECT / SESSION-pooled host (NOT the transaction pooler on port
# 6543) because the app uses asyncpg, which relies on prepared statements that
# are incompatible with transaction pooling.
#
#   Direct host:       db.<project-ref>.supabase.co
#   Session pooler:    aws-0-<region>.pooler.supabase.com  (port 5432)
DATABASE_HOST=db.<your-project-ref>.supabase.co
DATABASE_PORT=5432
DATABASE_NAME=postgres
DATABASE_USER=postgres
# The database password you set in Supabase (Project Settings -> Database).
DATABASE_PASSWORD=<your-supabase-database-password>

# Keep SQL echo OFF in production.
DATABASE_ECHO=false

# -----------------------------------------------------------------------------
# REQUIRED — validate with: python -c "import secrets; print(secrets.token_hex(32))"
# -----------------------------------------------------------------------------
SECRET_KEY=<your-random-secret-key-at-least-32-chars>

# -----------------------------------------------------------------------------
# NOTE ON SSL
# -----------------------------------------------------------------------------
# Supabase requires TLS. asyncpg and psycopg2 negotiate SSL by default
# (sslmode=prefer), so no extra setting is needed. If your provider forces
# non-default SSL options, you would need to extend app/core/config.py to
# append `?sslmode=require` — none of the existing code required it.
#
# NOTE ON POSTGIS
# -----------------------------------------------------------------------------
# Before running `alembic upgrade head`, execute deploy/supabase/extensions.sql
# in the Supabase SQL Editor so the `postgis` extension (and the `extensions`
# search_path) exist for the geometry columns.
