# =============================================================================
# Land Intelligence Frontend — Production (Vercel) environment
# =============================================================================
# Do NOT commit real values here. Set these in the Vercel dashboard:
#   Your project -> Settings -> Environment Variables -> Production
# (Or via the Vercel CLI: `vercel env add`.)
#
# Copy this file to `.env.production` ONLY if you build locally with production
# values; otherwise configure them directly in Vercel.
# =============================================================================

# Backend API base URL — your Hugging Face Space URL (WITHOUT a trailing
# `/api/v1`; the axios client appends it automatically).
# Replace <your-username> and <space-name>:
VITE_API_URL=https://<your-username>-land-intelligence-backend.hf.space

# Application display name
VITE_APP_NAME=Land Intelligence

# Feature flags / debugging (keep OFF in production)
VITE_ENABLE_DEBUG=false
